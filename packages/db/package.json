{
  "name": "@fastpro/db",
  "version": "0.0.0",
  "private": true,
  "description": "Executor de migracoes SQL (supabase/migrations) e testes de catalogo do banco",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@fastpro/config": "workspace:*",
    "pg": "8.23.1",
    "@fastpro/domain": "workspace:*",
    "@fastpro/testkit": "workspace:*"
  }
}
