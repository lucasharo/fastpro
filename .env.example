# FastPro - variaveis de ambiente (apenas NOMES; nunca coloque valores aqui).
# Copie para .env.local (ignorado pelo Git) e preencha localmente.
# Fonte: docs/factory/19-PLANO-TECNICO-DEV.md §7.

# --- Publico (vai ao navegador; NEXT_PUBLIC_*) ---
NEXT_PUBLIC_APP_ENV=
NEXT_PUBLIC_APP_BASE_URL=
NEXT_PUBLIC_ADMIN_BASE_URL=
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_MAPBOX_PUBLIC_TOKEN=

# --- Servidor (API e jobs) ---
APP_ENV=
APP_BASE_URL=
ADMIN_BASE_URL=
LOG_LEVEL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL_APP_API=
DATABASE_URL_APP_SYSTEM=
DATABASE_URL_MIGRATIONS=
DB_PASSWORD_APP_API=
DB_PASSWORD_APP_SYSTEM=

# --- Segredos de dominio (HMAC/criptografia) ---
PEPPER_EMAIL_HMAC=
PEPPER_CODE_HMAC=
PEPPER_IP_HMAC=
# H-019: chave propria do limite de taxa da busca de servico (>= 32 caracteres); nunca reutiliza PEPPER_*.
CATALOG_RATE_HMAC_KEY=
DOCUMENT_HMAC_KEY=
DATA_ENC_KEY_V1=
DATA_ENC_KEY_ACTIVE_VERSION=
SESSION_COOKIE_SECRET=
JOBS_TICK_SECRET=
CRON_SECRET=

# --- Desafio de acesso do cliente (H-011; apenas nomes) ---
AUTH_CHALLENGE_KEY=
SITE_URL=
# H-025: chave propria do HMAC do IP do rascunho sem conta (>= 32 caracteres); nunca reutiliza PEPPER_*. Sem valor aqui.
DRAFT_IP_HMAC_KEY=
# H-031 (#44): chave HMAC dos baldes de taxa da publicacao e do token de duplicidade (>= 32 caracteres); nunca reutiliza PEPPER_*. Sem valor aqui.
REQUEST_PUBLISH_HMAC_KEY=

# E3 (#141): liberacao da midia (fotos). Somente o valor exato 1 libera; ausente = fechada em todos os ambientes (decisao 190). Producao nao define.
MEDIA_UPLOAD_ENABLED=
# H-037 (#50): documentos de identidade. IDENTITY_DOCS_ENABLED so libera com o valor exato 1 (ausente = fechada em todos os ambientes).
# IDENTITY_DOCS_L1_PARECER e exigido com VERCEL_ENV=production (dado C3 sem prazo; so depois do parecer L1). Sem valor aqui.
IDENTITY_DOCS_ENABLED=
IDENTITY_DOCS_L1_PARECER=
# Issue 52 (H-039, pergunta 402): credencial SOMENTE LEITURA do bucket identity-docs, usada so pela leitura da
# Verificacao. Ausente = a rota de leitura responde 404 (fechada). Sem valor aqui.
IDENTITY_DOCS_READER_KEY=

# --- E-mail ---
# APP_ENV (servidor): local, test, preview, staging ou production (lista fechada em packages/email/src/env.ts).
EMAIL_PROVIDER=
EMAIL_FROM=
RESEND_API_KEY=
RESEND_VERIFIED_DOMAIN=
RESEND_ACCOUNT_RECIPIENT=
RESEND_WEBHOOK_SECRET=

# --- Mapbox (servidor) ---
# APP_ENV de desenvolvimento (development, dev ou test) NUNCA deve ser definido em preview ou producao: o provedor real da publicacao (Issue 44, decisao 239) so liga com esse APP_ENV e com VERCEL_ENV ausente ou development. Sem valor aqui.
MAPBOX_ACCESS_TOKEN=
MAPBOX_PERMANENT_SOFT_LIMIT=
MAPBOX_PERMANENT_HARD_LIMIT=
# H-021: chave propria do HMAC do endereço (hash da coordenada permanente); nunca reutiliza PEPPER_*. Sem valor aqui.
ADDRESS_HASH_KEY=
# H-032 (Issue 45): chave da cifra do endereco do pedido (AES-256-GCM, minimo 32 caracteres). Sem valor aqui; so o dono grava.
ADDRESS_ENC_KEY=
# H-033 (Issue 46): chave da cifra do telefone do pedido (AES-256-GCM, minimo 32 caracteres). Sem valor aqui; so o dono grava.
PHONE_ENC_KEY=
# H-020: autocomplete temporario. Interruptor e tetos da cota mensal; valores fora deste arquivo.
ADDRESS_SUGGEST_ENABLED=
MAPBOX_TEMP_SOFT_LIMIT=
MAPBOX_TEMP_HARD_LIMIT=

# --- Mercado Pago ---
MP_ENV=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PK=
MP_WEBHOOK_SECRET=

# --- Teste/CI (nunca em producao) ---
CLOCK_OVERRIDE_ENABLED=
ALLOW_EXTERNAL_EGRESS=
AUDIT_ALLOW_COMMIT=

# --- Backup e keep-alive (H-010; apenas nomes) ---
DATABASE_URL_BACKUP_READ=
DATABASE_URL_KEEPALIVE=
BACKUP_DIR=
BACKUP_EXPECTED_DB_REF=
BACKUP_PASSPHRASE_FILE=
KEEPALIVE_LOG=

# Teste manual da Issue 44 (dbtest H-031): 1 pula a limpeza final das linhas sinteticas. Sem valor por padrao.
H031_SEM_LIMPEZA=
