# FastPro - variaveis de ambiente (apenas NOMES; nunca coloque valores aqui).
# Copie para .env.local (ignorado pelo Git) e preencha localmente.
# Fonte: docs/factory/19-PLANO-TECNICO-DEV.md §7.

# --- Publico (vai ao navegador; NEXT_PUBLIC_*) ---
NEXT_PUBLIC_APP_ENV=
NEXT_PUBLIC_APP_BASE_URL=
NEXT_PUBLIC_ADMIN_BASE_URL=
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_MAPBOX_PUBLIC_TOKEN=

# --- Servidor (API e jobs) ---
APP_ENV=
APP_BASE_URL=
ADMIN_BASE_URL=
LOG_LEVEL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL_APP_API=
DATABASE_URL_APP_SYSTEM=
DATABASE_URL_MIGRATIONS=
DB_PASSWORD_APP_API=
DB_PASSWORD_APP_SYSTEM=

# --- Segredos de dominio (HMAC/criptografia) ---
PEPPER_EMAIL_HMAC=
PEPPER_CODE_HMAC=
PEPPER_IP_HMAC=
DOCUMENT_HMAC_KEY=
DATA_ENC_KEY_V1=
DATA_ENC_KEY_ACTIVE_VERSION=
SESSION_COOKIE_SECRET=
JOBS_TICK_SECRET=
CRON_SECRET=

# --- Desafio de acesso do cliente (H-011; apenas nomes) ---
AUTH_CHALLENGE_KEY=
SITE_URL=

# --- E-mail ---
# APP_ENV (servidor): local, test, preview, staging ou production (lista fechada em packages/email/src/env.ts).
EMAIL_PROVIDER=
EMAIL_FROM=
RESEND_API_KEY=
RESEND_VERIFIED_DOMAIN=
RESEND_ACCOUNT_RECIPIENT=
RESEND_WEBHOOK_SECRET=

# --- Mapbox (servidor) ---
MAPBOX_ACCESS_TOKEN_SERVER=
MAPBOX_PERMANENT_SOFT_LIMIT=
MAPBOX_PERMANENT_HARD_LIMIT=
# H-020: autocomplete temporario. Interruptor e tetos da cota mensal; valores fora deste arquivo.
ADDRESS_SUGGEST_ENABLED=
MAPBOX_TEMP_SOFT_LIMIT=
MAPBOX_TEMP_HARD_LIMIT=

# --- Mercado Pago ---
MP_ENV=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PK=
MP_WEBHOOK_SECRET=

# --- Teste/CI (nunca em producao) ---
CLOCK_OVERRIDE_ENABLED=
ALLOW_EXTERNAL_EGRESS=
AUDIT_ALLOW_COMMIT=

# --- Backup e keep-alive (H-010; apenas nomes) ---
DATABASE_URL_BACKUP_READ=
DATABASE_URL_KEEPALIVE=
BACKUP_DIR=
BACKUP_EXPECTED_DB_REF=
BACKUP_PASSPHRASE_FILE=
KEEPALIVE_LOG=
