# FastPro - variaveis de ambiente (apenas NOMES; nunca coloque valores aqui).
# Copie para .env.local (ignorado pelo Git) e preencha localmente.
# Fonte: docs/factory/19-PLANO-TECNICO-DEV.md §7.

# --- Publico (vai ao navegador; NEXT_PUBLIC_*) ---
NEXT_PUBLIC_APP_ENV=
NEXT_PUBLIC_APP_BASE_URL=
NEXT_PUBLIC_ADMIN_BASE_URL=
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_MAPBOX_PUBLIC_TOKEN=

# --- Servidor (API e jobs) ---
APP_ENV=
APP_BASE_URL=
ADMIN_BASE_URL=
LOG_LEVEL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL_APP_API=
DATABASE_URL_APP_SYSTEM=
DATABASE_URL_MIGRATIONS=
DB_PASSWORD_APP_API=
DB_PASSWORD_APP_SYSTEM=

# --- Segredos de dominio (HMAC/criptografia) ---
