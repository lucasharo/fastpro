{
  "name": "@fastpro/web",
  "version": "0.0.0",
  "private": true,
  "description": "Web da hospedagem Vercel (H-009): estrutura estatica e cabecalhos; telas em historias futuras",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "copy:tokens": "node scripts/copy-tokens.mjs",
    "build": "node scripts/copy-tokens.mjs && tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/copy-tokens.mjs && vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@fastpro/config": "workspace:*",
    "@fastpro/domain": "workspace:*"
  }
}
