{
  "name": "fastpro",
  "version": "0.0.0",
  "private": true,
  "description": "FastPro - monorepo (pnpm + Turborepo)",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint:scripts": "eslint scripts eslint.config.mjs",
    "test:scripts": "node --test \"scripts/__tests__/*.test.mjs\"",
    "db:migrate": "node packages/db/scripts/db.mjs migrate",
    "db:status": "node packages/db/scripts/db.mjs status",
    "db:test": "node --test --test-concurrency=1 \"packages/db/tests/*.dbtest.mjs\"",
    "db:backup": "node packages/db/scripts/backup.mjs",
    "db:keepalive": "node packages/db/scripts/keepalive.mjs",
    "check:deps": "node scripts/check-workspace-deps.mjs",
    "check:hex": "node scripts/check-hex.mjs",
    "check:typography": "node scripts/check-typography.mjs",
    "check:env": "node scripts/check-env-example.mjs",
    "check:boundaries": "node scripts/check-module-boundaries.mjs",
    "check:attachments": "node scripts/check-no-attachments.mjs",
    "check:logs": "node scripts/check-logs.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:secrets:history": "node scripts/check-secrets.mjs --history",
    "check:email-switch": "node scripts/check-no-email-switch.mjs --selftest && node scripts/check-no-email-switch.mjs",
    "check:all": "pnpm check:deps && pnpm check:hex && pnpm check:typography && pnpm check:env && pnpm check:boundaries && pnpm check:attachments && pnpm check:logs && pnpm check:secrets",
    "audit:deps": "pnpm audit --audit-level=high",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
